// Запустите эту функцию ОДИН РАЗ для добавления колонок описания и хранения в Products
function addProductColumns() {
  var ss = SpreadsheetApp.getActiveSpreadsheet();
  var prodSheet = ss.getSheetByName('Products');
  if (!prodSheet) { SpreadsheetApp.getUi().alert('Лист Products не найден!'); return; }

  var headers = prodSheet.getRange(1, 1, 1, prodSheet.getLastColumn()).getValues()[0];
  if (headers.indexOf('description') === -1) {
    var nextCol = prodSheet.getLastColumn() + 1;
    prodSheet.getRange(1, nextCol).setValue('description');
    prodSheet.getRange(1, nextCol + 1).setValue('storage');
    SpreadsheetApp.getUi().alert('Колонки description и storage добавлены в Products! Заполните описания вручную.');
  } else {
    SpreadsheetApp.getUi().alert('Колонки уже существуют.');
  }
}
