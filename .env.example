# Telegram Bot Token (получить у @BotFather)
BOT_TOKEN=your_bot_token_here

# URL где хостится ваше приложение (для Mini App)
# Для теста можно использовать ngrok: https://your-id.ngrok.io
APP_URL=https://your-domain.com

# Порт сервера
PORT=3000

# Google Sheets
# ID таблицы из URL: https://docs.google.com/spreadsheets/d/SPREADSHEET_ID/edit
SPREADSHEET_ID=your_spreadsheet_id_here

# Локально: путь к файлу ключей
GOOGLE_KEY_FILE=./google-credentials.json

# На сервере (Railway/Render): вставить весь JSON одной строкой
# GOOGLE_CREDENTIALS_JSON={"type":"service_account","project_id":"...","private_key":"...",...}

# Время кэширования данных из таблицы (в секундах)
CACHE_TTL=300
